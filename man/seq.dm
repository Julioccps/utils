NAME
    \Sseq\c - prints sequences of numbers

USAGE
    \Sseq\c [option] last | first last | first step last

OPTION
    --help, -h
        Shows the help message and exits
    --version, -v
        Shows version info and exits
    --equal-width, -w
        Equalizes width with largest number with zeros
    --separator \BSTRING\c, -s \BSTRING\c
        Uses \BSTRING\c as the separator, default: '\\n'
